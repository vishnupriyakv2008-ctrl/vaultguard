# All variables are optional - the app runs with built-in defaults.
# Copy this file to .env to override them.

# Port the server listens on (default: 3000)
PORT=3000

# RevenueCat public/test API key used for the subscription gateway
REVENUECAT_API_KEY="test_OAHnTjVUPYvUSapPhEoSLMDbGwR"

# Secret used to sign login tokens (JWT) - change this
JWT_SECRET="change-me-to-a-long-random-string"

# Key used to derive the AES-256-GCM field-encryption key - change this
ENCRYPTION_KEY="change-me-to-another-long-random-string"
